---
import { getContent } from '../data/cv';
const { profile, ui } = getContent(Astro.currentLocale);
const { social } = profile;
const c = ui.sections.contact;
const year = new Date().getFullYear();
---

<footer id="contact" class="scroll-mt-20 border-t border-white/5 py-24">
  <div class="mx-auto max-w-5xl px-5 text-center sm:px-8">
    <p class="eyebrow">{c.eyebrow}</p>
    <p class="reveal mx-auto mt-4 max-w-xl leading-relaxed text-fog-400">
      {c.title}
    </p>

    <a
      href={`mailto:${social.email}`} data-umami-event="email-click" data-umami-event-location="contact"
      class="reveal mt-8 inline-flex items-center gap-2 rounded-full bg-accent-500 px-6 py-3 text-base font-semibold text-ink-950 transition-colors hover:bg-accent-400"
    >
      {social.email}
    </a>

    <div class="reveal mt-6 flex justify-center gap-3">
      <a
        href={social.github} data-umami-event="outbound-github" data-umami-event-location="contact"
        rel="noopener"
        class="rounded-full border border-white/10 px-5 py-2 text-sm font-medium text-fog-200 transition-colors hover:border-white/25 hover:text-fog-100"
      >
        GitHub
      </a>
      <a
        href={social.linkedin} data-umami-event="outbound-linkedin" data-umami-event-location="contact"
        rel="noopener"
        class="rounded-full border border-white/10 px-5 py-2 text-sm font-medium text-fog-200 transition-colors hover:border-white/25 hover:text-fog-100"
      >
        LinkedIn
      </a>
    </div>

    <p class="mt-16 font-mono text-xs text-fog-500">
      &copy; {year} {profile.name} &middot; {c.footer}
    </p>
  </div>
</footer>
