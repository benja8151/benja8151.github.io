---
import Section from './Section.astro';
import DeviceFrame from './DeviceFrame.astro';
import { projects } from '../data/cv';
const featured = projects.find((p) => p.featured)!;
const rest = projects.filter((p) => !p.featured);
---

<Section id="projects" eyebrow="Showcase" title="Products I've built">
  <!-- Featured: The NU (largest visual treatment) -->
  <article class="reveal grid items-center gap-8 rounded-3xl border border-white/5 bg-ink-900/40 p-6 sm:p-10 lg:grid-cols-2 lg:gap-12">
    <div class="order-2 lg:order-1">
      <div class="flex items-center gap-3">
        <img src={featured.logo.src} alt={featured.logo.alt} width="44" height="44" class="h-11 w-11 rounded-xl border border-white/10 bg-ink-800 object-contain p-1" />
        <div>
          <h3 class="text-2xl font-semibold text-fog-100">{featured.name}</h3>
          <p class="font-mono text-xs tracking-wide text-accent-400">{featured.tagline}</p>
        </div>
      </div>
      <p class="mt-5 leading-relaxed text-fog-400">{featured.description}</p>
      <p class="mt-4 text-sm text-fog-500">{featured.role}</p>
      <div class="mt-5 flex flex-wrap gap-2">
        {featured.stack.map((s) => (
          <span class="rounded-md border border-white/10 px-2.5 py-1 font-mono text-xs text-fog-400">{s}</span>
        ))}
      </div>
    </div>
    <div class="order-1 flex justify-center gap-4 lg:order-2">
      {featured.mockups.map((m, i) => (
        <DeviceFrame src={m.src} alt={m.alt} class={`w-40 sm:w-48 ${i === 1 ? 'mt-8 hidden sm:block' : ''}`} />
      ))}
    </div>
  </article>

  <!-- Secondary projects -->
  <div class="mt-8 grid gap-8 md:grid-cols-2">
    {
      rest.map((p) => (
        <article class="reveal flex flex-col rounded-3xl border border-white/5 bg-ink-900/40 p-6 sm:p-8">
          <div class="flex items-center gap-3">
            <img src={p.logo.src} alt={p.logo.alt} width="40" height="40" class="h-10 w-10 rounded-xl border border-white/10 bg-ink-800 object-contain p-1" />
            <div>
              <h3 class="text-xl font-semibold text-fog-100">{p.name}</h3>
              <p class="font-mono text-xs tracking-wide text-accent-400">{p.tagline}</p>
            </div>
          </div>
          <div class="my-6 flex justify-center">
            {p.mockups.map((m) => (
              <DeviceFrame src={m.src} alt={m.alt} class="w-32 sm:w-36" />
            ))}
          </div>
          <p class="leading-relaxed text-fog-400">{p.description}</p>
          <p class="mt-3 text-sm text-fog-500">{p.role}</p>
          <div class="mt-auto pt-5 flex flex-wrap gap-2">
            {p.stack.map((s) => (
              <span class="rounded-md border border-white/10 px-2.5 py-1 font-mono text-xs text-fog-400">{s}</span>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</Section>
