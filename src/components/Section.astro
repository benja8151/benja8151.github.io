---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
}
const { id, eyebrow, title } = Astro.props;
---

<section id={id} class="scroll-mt-20 border-t border-white/5 py-20 sm:py-28">
  <div class="mx-auto max-w-5xl px-5 sm:px-8">
    <header class="reveal mb-12 max-w-2xl">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-fog-100 sm:text-4xl">
        {title}
      </h2>
    </header>
    <slot />
  </div>
</section>
