---
import Section from './Section.astro';
import { experience } from '../data/cv';
// Render newest-first so the reader lands on the current role, but the rail
// still connects the full chronology.
const roles = [...experience].reverse();
---

<Section id="experience" eyebrow="Experience" title="A path through the stack">
  <div id="timeline" class="relative">
    <!-- Sticky progress rail (desktop). -->
    <div
      class="pointer-events-none absolute top-0 bottom-0 left-[7px] w-px bg-white/10 sm:left-[9px]"
      aria-hidden="true"
    >
      <div id="rail-fill" class="rail-fill w-full bg-accent-500" style="height: 0%"></div>
    </div>

    <ol class="space-y-12">
      {
        roles.map((r) => (
          <li class="timeline-item reveal relative pl-8 sm:pl-12" data-id={r.id}>
            <span
              class="timeline-dot absolute top-1.5 left-0 h-4 w-4 rounded-full border-2 border-ink-950 bg-ink-700 ring-4 ring-ink-950 transition-colors"
              aria-hidden="true"
            />
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="text-xl font-semibold text-fog-100">{r.role}</h3>
              <span class="font-mono text-xs tracking-wide text-fog-500">{r.period}</span>
            </div>
            <p class="mt-1 text-sm font-medium text-accent-300">
              {r.company}
              {r.companyNote && (
                <span class="text-fog-500"> ({r.companyNote})</span>
              )}
            </p>
            {!r.minimal && (
              <p class="mt-3 max-w-2xl leading-relaxed text-fog-400">{r.summary}</p>
            )}
            {r.minimal && (
              <p class="mt-2 max-w-2xl text-sm leading-relaxed text-fog-500">{r.summary}</p>
            )}
            {r.highlights.length > 0 && (
              <ul class="mt-4 space-y-2">
                {r.highlights.map((h) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-fog-400">
                    <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent-500" aria-hidden="true" />
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</Section>

<script>
  import { initTimeline } from '../scripts/timeline';
  initTimeline();
</script>
