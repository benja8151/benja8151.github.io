---
import Section from './Section.astro';
import { getContent } from '../data/cv';
const { skills, ui } = getContent(Astro.currentLocale);
const s = ui.sections.skills;
---

<Section id="skills" eyebrow={s.eyebrow} title={s.title}>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      skills.map((group) => (
        <div class="reveal rounded-2xl border border-white/5 bg-ink-900/50 p-6">
          <h3 class="font-mono text-xs uppercase tracking-widest text-fog-500">
            {group.category}
          </h3>
          <div class="mt-4 flex flex-wrap gap-2">
            {group.proficient.map((sk) => (
              <span class="rounded-md border border-accent-500/30 bg-accent-500/10 px-2.5 py-1 text-sm font-medium text-accent-300">
                {sk}
              </span>
            ))}
            {group.familiar.map((sk) => (
              <span class="rounded-md border border-white/10 px-2.5 py-1 text-sm text-fog-400">
                {sk}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
  <p class="reveal mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-fog-500">
    <span class="flex items-center gap-2">
      <span class="inline-block h-3 w-3 rounded-sm border border-accent-500/30 bg-accent-500/10"></span>
      {ui.proficient}
    </span>
    <span class="flex items-center gap-2">
      <span class="inline-block h-3 w-3 rounded-sm border border-white/10"></span>
      {ui.familiar}
    </span>
  </p>
</Section>
