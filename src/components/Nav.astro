---
import { getContent, type Locale } from '../data/cv';
const loc: Locale = Astro.currentLocale === 'sl' ? 'sl' : 'en';
const { profile, sections, ui } = getContent(loc);
const initials = profile.name
  .split(' ')
  .map((w) => w[0])
  .join('');

const langLink = 'font-mono text-xs px-1.5 py-0.5 rounded transition-colors';
const langActive = 'text-accent-300 font-medium';
const langIdle = 'text-fog-500 hover:text-fog-200';
---

<header
  class="fixed inset-x-0 top-0 z-40 border-b border-white/5 bg-ink-950/70 backdrop-blur-md"
>
  <nav
    class="mx-auto flex h-16 max-w-5xl items-center justify-between px-5 sm:px-8"
    aria-label="Primary"
  >
    <a href="#top" class="font-mono text-sm font-medium tracking-widest text-fog-100">
      {initials}<span class="text-accent-400">.</span>
    </a>
    <ul class="hidden items-center gap-7 text-sm text-fog-400 md:flex">
      {
        sections.map((s) => (
          <li>
            <a href={`#${s.id}`} class="transition-colors hover:text-fog-100">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="flex items-center gap-3">
      <div class="flex items-center" role="group" aria-label="Language">
        <a
          href="/"
          data-set-lang="en"
          hreflang="en"
          class={`${langLink} ${loc === 'en' ? langActive : langIdle}`}
          aria-current={loc === 'en' ? 'true' : undefined}
        >
          EN
        </a>
        <span class="text-fog-600" aria-hidden="true">/</span>
        <a
          href="/sl/"
          data-set-lang="sl"
          hreflang="sl"
          class={`${langLink} ${loc === 'sl' ? langActive : langIdle}`}
          aria-current={loc === 'sl' ? 'true' : undefined}
        >
          SL
        </a>
      </div>
      <a
        href={profile.cvPdf}
        class="rounded-full border border-accent-500/40 bg-accent-500/10 px-4 py-1.5 text-xs font-medium text-accent-300 transition-colors hover:bg-accent-500/20"
      >
        {ui.cvShort}
      </a>
    </div>
  </nav>
</header>

<script is:inline>
  // Remember the visitor's language choice when they use the toggle.
  document.querySelectorAll('[data-set-lang]').forEach(function (a) {
    a.addEventListener('click', function () {
      try { localStorage.setItem('lang', a.getAttribute('data-set-lang')); } catch (e) {}
    });
  });
</script>
