---
import { profile, sections } from '../data/cv';
const initials = profile.name
  .split(' ')
  .map((w) => w[0])
  .join('');
---

<header
  class="fixed inset-x-0 top-0 z-40 border-b border-white/5 bg-ink-950/70 backdrop-blur-md"
>
  <nav
    class="mx-auto flex h-16 max-w-5xl items-center justify-between px-5 sm:px-8"
    aria-label="Primary"
  >
    <a href="#top" class="font-mono text-sm font-medium tracking-widest text-fog-100">
      {initials}<span class="text-accent-400">.</span>
    </a>
    <ul class="hidden items-center gap-7 text-sm text-fog-400 md:flex">
      {
        sections.map((s) => (
          <li>
            <a
              href={`#${s.id}`}
              class="transition-colors hover:text-fog-100"
            >
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href={profile.cvPdf}
      class="rounded-full border border-accent-500/40 bg-accent-500/10 px-4 py-1.5 text-xs font-medium text-accent-300 transition-colors hover:bg-accent-500/20"
    >
      CV
    </a>
  </nav>
</header>
