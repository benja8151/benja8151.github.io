---
import type { ProjectImageSlot } from '../data/cv';

interface Props {
  images: ProjectImageSlot[];
  /** Accessible label describing what the carousel contains. */
  label: string;
  /** Fixed width classes for each phone frame (controls slide size + peek). */
  frameClass?: string;
  /** Width classes for the carousel viewport. */
  class?: string;
}

const {
  images,
  label,
  frameClass = 'w-44 sm:w-52',
  class: className = 'mx-auto w-full max-w-[21rem]',
} = Astro.props;
const multiple = images.length > 1;
---

<div
  class={`carousel group relative ${className}`}
  data-carousel
  role="group"
  aria-roledescription="carousel"
  aria-label={label}
>
  <!-- Viewport clips the wider track; the mask fades the peeking neighbours. -->
  <div
    class="carousel-viewport overflow-hidden pb-2 [touch-action:pan-y]"
    data-viewport
    tabindex="0"
    aria-label={`${label} — swipe or use arrow keys`}
  >
    <!-- Track is positioned with translateX; the active slide is centered and
         the neighbours peek at the edges. Looping is handled in the script by
         cloning the first/last slides and resetting the transform instantly. -->
    <div class="carousel-track flex items-center gap-0 will-change-transform" data-track>
      {
        images.map((m, i) => (
          <div
            class="carousel-slide flex shrink-0 justify-center transition-[opacity,scale] duration-500 ease-out"
            data-slide
          >
            {/* Images already include the device frame, so display them as-is
                (natural aspect, no cropping/clipping) with a soft drop shadow. */}
            <img
              src={m.src}
              alt={`${m.alt} (${i + 1} of ${images.length})`}
              loading="lazy"
              decoding="async"
              class={`${frameClass} h-auto object-contain [filter:drop-shadow(0_18px_30px_rgba(0,0,0,0.5))]`}
            />
          </div>
        ))
      }
    </div>
  </div>

  {
    multiple && (
      <>
        <button
          type="button"
          data-prev
          class="carousel-btn absolute top-1/2 left-0 z-10 hidden -translate-y-1/2 items-center justify-center rounded-full border border-white/10 bg-ink-950/80 p-2 text-fog-100 backdrop-blur transition hover:bg-ink-800 disabled:pointer-events-none disabled:opacity-30 sm:flex"
          aria-label="Previous screenshot"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button
          type="button"
          data-next
          class="carousel-btn absolute top-1/2 right-0 z-10 hidden -translate-y-1/2 items-center justify-center rounded-full border border-white/10 bg-ink-950/80 p-2 text-fog-100 backdrop-blur transition hover:bg-ink-800 disabled:pointer-events-none disabled:opacity-30 sm:flex"
          aria-label="Next screenshot"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <div class="mt-3 flex justify-center gap-2" data-dots aria-hidden="true">
          {images.map((_, i) => (
            <button
              type="button"
              data-dot
              class="h-2 w-2 rounded-full bg-fog-500/40 transition-all"
              tabindex="-1"
              aria-label={`Go to screenshot ${i + 1}`}
            />
          ))}
        </div>
      </>
    )
  }
</div>

<script>
  import { initCarousels } from '../scripts/carousel';
  initCarousels();
</script>
