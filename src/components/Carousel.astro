---
import DeviceFrame from './DeviceFrame.astro';
import type { ProjectImageSlot } from '../data/cv';

interface Props {
  images: ProjectImageSlot[];
  /** Tailwind width classes applied to each device frame. */
  frameClass?: string;
  /** Accessible label describing what the carousel contains. */
  label: string;
}

const { images, frameClass = 'w-40 sm:w-48', label } = Astro.props;
const multiple = images.length > 1;
---

<div
  class="carousel group relative"
  data-carousel
  role="group"
  aria-roledescription="carousel"
  aria-label={label}
>
  <!-- Scrollable track: native touch/trackpad swipe on all devices. -->
  <div
    class="carousel-track flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth px-1 pb-2 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    data-track
    tabindex="0"
    aria-label={`${label} — swipe or use arrow keys`}
  >
    {
      images.map((m, i) => (
        <div class="carousel-slide flex w-full shrink-0 snap-center justify-center" data-slide>
          <DeviceFrame src={m.src} alt={`${m.alt} (${i + 1} of ${images.length})`} class={frameClass} />
        </div>
      ))
    }
  </div>

  {
    multiple && (
      <>
        {/* Desktop controls — hidden on touch-first small screens where swipe is natural. */}
        <button
          type="button"
          data-prev
          class="carousel-btn absolute top-1/2 left-1 hidden -translate-y-1/2 items-center justify-center rounded-full border border-white/10 bg-ink-950/80 p-2 text-fog-100 backdrop-blur transition hover:bg-ink-800 disabled:pointer-events-none disabled:opacity-0 sm:flex"
          aria-label="Previous screenshot"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button
          type="button"
          data-next
          class="carousel-btn absolute top-1/2 right-1 hidden -translate-y-1/2 items-center justify-center rounded-full border border-white/10 bg-ink-950/80 p-2 text-fog-100 backdrop-blur transition hover:bg-ink-800 disabled:pointer-events-none disabled:opacity-0 sm:flex"
          aria-label="Next screenshot"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        {/* Position dots — indicator + tap targets on all screen sizes. */}
        <div class="mt-3 flex justify-center gap-2" data-dots aria-hidden="true">
          {images.map((_, i) => (
            <button
              type="button"
              data-dot
              class="h-2 w-2 rounded-full bg-fog-500/40 transition-colors"
              tabindex="-1"
              aria-label={`Go to screenshot ${i + 1}`}
            />
          ))}
        </div>
      </>
    )
  }
</div>

<script>
  import { initCarousels } from '../scripts/carousel';
  initCarousels();
</script>
