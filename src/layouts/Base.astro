---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { getContent, type Locale } from '../data/cv';

interface Props {
  title?: string;
  description?: string;
}

const loc: Locale = Astro.currentLocale === 'sl' ? 'sl' : 'en';
const { profile, ui } = getContent(loc);

const {
  title = `${profile.name} — ${profile.tagline}`,
  description = ui.metaDescription,
} = Astro.props;

const siteBase = Astro.site ?? new URL('https://benja8151.github.io');
const canonical = new URL(loc === 'sl' ? '/sl/' : '/', siteBase).href;
const enUrl = new URL('/', siteBase).href;
const slUrl = new URL('/sl/', siteBase).href;
const ogImage = new URL('/assets/og-image.svg', siteBase).href;
const ogLocale = loc === 'sl' ? 'sl_SI' : 'en_US';
---

<!doctype html>
<html lang={loc}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="sl" href={slUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#0d1117" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="generator" content={Astro.generator} />

    <!-- Umami Cloud analytics (cookieless, honors Do Not Track). Production only. -->
    {
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id="ef4e37a6-1512-4d6f-8882-a35add85bf0c"
          data-do-not-track="true"
        />
      )
    }

    <script is:inline>
      // First-visit language: honor a stored choice, else fall back to the
      // browser language (Slovenian -> /sl/). A session flag avoids loops.
      (function () {
        try {
          var path = location.pathname;
          var isSL = path === '/sl' || path.indexOf('/sl/') === 0;
          var cur = isSL ? 'sl' : 'en';
          var stored = localStorage.getItem('lang');
          var redirected = sessionStorage.getItem('langRedirected');
          var target = null;
          if (stored === 'sl' || stored === 'en') {
            if (stored !== cur) target = stored;
          } else if (!redirected) {
            var pref = (navigator.languages && navigator.languages[0]) || navigator.language || 'en';
            var want = /^sl/i.test(pref) ? 'sl' : 'en';
            if (want !== cur) target = want;
          }
          if (target && !redirected) {
            sessionStorage.setItem('langRedirected', '1');
            location.replace(target === 'sl' ? '/sl/' : '/');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:bg-accent-500 focus:px-4 focus:py-2 focus:text-ink-950"
    >
      Skip to content
    </a>
    <Nav />
    <main id="main">
      <slot />
    </main>

    <script>
      import { initAnalytics } from '../scripts/analytics';
      initAnalytics();
    </script>
  </body>
</html>
